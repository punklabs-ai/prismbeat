{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "prismbeat-support",
  "main": "src/index.ts",
  "compatibility_date": "2026-08-27",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": false,
  "routes": [
    {
      "pattern": "support-api.prismbeat.app",
      "custom_domain": true
    }
  ],
  "send_email": [
    {
      "name": "EMAIL",
      "allowed_sender_addresses": ["support-form@prismbeat.app"]
    }
  ],
  "ratelimits": [
    {
      "name": "IP_RATE_LIMITER",
      "namespace_id": "726418",
      "simple": {
        "limit": 6,
        "period": 60
      }
    },
    {
      "name": "EMAIL_RATE_LIMITER",
      "namespace_id": "726419",
      "simple": {
        "limit": 2,
        "period": 60
      }
    }
  ],
  "observability": {
    "enabled": true,
    "logs": {
      "head_sampling_rate": 1
    },
    "traces": {
      "enabled": true,
      "head_sampling_rate": 0.05
    }
  }
}
